# InterviewMate AI Environment Configuration

# Next.js Public App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Gemini API Key (Optional for live AI - fallback simulated AI is built-in)
GEMINI_API_KEY=your_gemini_api_key_here
NEXT_PUBLIC_GEMINI_API_KEY=

# Google OAuth Credentials (Optional - built-in 1-Click Demo Accounts available)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
NEXTAUTH_SECRET=your_nextauth_secret_minimum_32_characters_random
NEXTAUTH_URL=http://localhost:3000

# Demo Mode toggle (Default: true)
NEXT_PUBLIC_DEMO_MODE=true
